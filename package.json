{
  "name": "funkade",
  "version": "0.1.0",
  "private": true,
  "description": "Plataforma web para jugar Friday Night Funkin' y mods compatibles en el navegador",
  "type": "module",
  "scripts": {
    "build": "bun tools/build.ts",
    "dev": "bun tools/build.ts && bun tools/serve.ts",
    "serve": "bun tools/serve.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test tests/unit",
    "catalog": "bun tools/build-catalog.ts",
    "gen:mods": "node tools/gen-mods.mjs && bun tools/build-catalog.ts",
    "e2e": "node tools/e2e.mjs",
    "bench": "node tools/e2e.mjs --bench"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  },
  "license": "MIT"
}
